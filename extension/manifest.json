{
  "manifest_version": 3,
  "name": "FB Unsave All",
  "version": "1.0.6",
  "minimum_chrome_version": "120",
  "description": "Limpia Guardados de Facebook uno por uno con pausa configurable, o por lotes en el Registro de actividad.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "FB Unsave All" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*"],
    "js": ["core.js", "saved.js", "saved-content.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
